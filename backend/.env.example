# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL - Neon/Railway free tier cho dev, connection string riêng cho production)
DATABASE_URL="postgresql://user:password@host:5432/lsr_club?schema=public&sslmode=require"

# JWT
JWT_SECRET=your_jwt_access_secret_change_me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_me
JWT_REFRESH_EXPIRES_IN=7d

# CORS (danh sách origin được phép, phân cách bằng dấu phẩy - thêm domain Vercel khi deploy)
CORS_ORIGIN=http://localhost:3000,https://nga-my.vercel.app

# Rate limit
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
